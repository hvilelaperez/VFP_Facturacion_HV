	IN LOCFILE("..\..\..\FUENTES\VFOX\VENTAS\PROGS\MENUNVTEC" ,"MPX;MPR|FXP;PRG" ,"WHERE is MENUNVTEC?")

DEFINE POPUP tablas MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF tablas PROMPT "Datos del Cliente"
DEFINE BAR 2 OF tablas PROMPT "\-"
DEFINE BAR 3 OF tablas PROMPT "Cambio de Contraseña"
ON SELECTION BAR 1 OF tablas do form clientes2
ON SELECTION BAR 3 OF tablas do form formcontraseña

DEFINE POPUP almacen MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF almacen PROMPT "Kardex"
DEFINE BAR 2 OF almacen PROMPT "Info. Ubicacion de Stock Fisico"
DEFINE BAR 3 OF almacen PROMPT "\-"
DEFINE BAR 4 OF almacen PROMPT "Informe de stock por lote - General - Almacenes SQM"
DEFINE BAR 5 OF almacen PROMPT "Informe de stock por lote - Colorantes y Auxiliares"
DEFINE BAR 6 OF almacen PROMPT "Informe de stock por lote - No Comercial - Lince"
DEFINE BAR 7 OF almacen PROMPT "Informe Stock Agrupado por  Productos - General - Amacenes SQM"
ON SELECTION BAR 1 OF almacen do form kardex
ON SELECTION BAR 2 OF almacen do form studiocd
ON SELECTION BAR 4 OF almacen do form istock_inventariot
ON SELECTION BAR 5 OF almacen Do Form istock_inventario
ON SELECTION BAR 6 OF almacen do form infostocknocomercial
ON SELECTION BAR 7 OF almacen do form ainfoarticulos

DEFINE POPUP vendedores MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF vendedores PROMPT "Historico de Ventas en Kilos  Agrupado por Productos"
DEFINE BAR 2 OF vendedores PROMPT "Historico de Ventas en Kilos  Agrupado por Clientes"
DEFINE BAR 3 OF vendedores PROMPT "Historico de Ventas en  US$  Agrupado por Producto"
DEFINE BAR 4 OF vendedores PROMPT "Historico de Ventas en Kilos de Productos por Cliente"
DEFINE BAR 5 OF vendedores PROMPT "Historico de Ventas en Kilos de Clientes por Productos"
DEFINE BAR 6 OF vendedores PROMPT "\-"
DEFINE BAR 7 OF vendedores PROMPT "Venta por Vendedor"
DEFINE BAR 8 OF vendedores PROMPT "Venta por Cliente"
DEFINE BAR 9 OF vendedores PROMPT "Venta por Articulo"
DEFINE BAR 10 OF vendedores PROMPT "Venta por Tipo de Producto"
ON SELECTION BAR 1 OF vendedores do form cubehistory
ON SELECTION BAR 2 OF vendedores do form cubehistorycte
ON SELECTION BAR 3 OF vendedores do form cubehistorymoney
ON SELECTION BAR 4 OF vendedores do form cubehistory2
ON SELECTION BAR 5 OF vendedores do form cubehistory3
ON SELECTION BAR 7 OF vendedores do form vtasxvendedores
ON SELECTION BAR 8 OF vendedores do form vtasxcliente
ON SELECTION BAR 9 OF vendedores do form vtasxarticulo
ON SELECTION BAR 10 OF vendedores do form vtasxtipoproducto


