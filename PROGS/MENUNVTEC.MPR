	KEY ALT+T, ""
DEFINE PAD _58p104u0s OF _MSYSMENU PROMPT "Almacen" COLOR SCHEME 3 ;
	KEY ALT+A, ""
DEFINE PAD _58p104u0t OF _MSYSMENU PROMPT "Vendedores" COLOR SCHEME 3 ;
